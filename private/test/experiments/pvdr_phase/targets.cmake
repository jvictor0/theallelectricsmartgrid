set(PVDR_EXPERIMENT_DIR "${TEST_DIR}/experiments/pvdr_phase")
foreach(variant current floor60 schmitt)
    add_executable(pvdr_${variant} "${PVDR_EXPERIMENT_DIR}/render.cpp")
    target_include_directories(pvdr_${variant} PRIVATE "${PASSTHROUGH_RATE_SRC_DIR}"
        "${REPO_ROOT}/formal/DSP/generated")
    target_compile_options(pvdr_${variant} PRIVATE -Wall -Wextra -Wno-unused-parameter)
    if(variant STREQUAL "schmitt")
        target_compile_definitions(pvdr_${variant} PRIVATE PVDR_EXPERIMENT_SCHMITT=1)
    elseif(variant STREQUAL "current")
        target_compile_definitions(pvdr_${variant} PRIVATE PVDR_EXPERIMENT_FLOOR=1e-8)
    else()
        target_compile_definitions(pvdr_${variant} PRIVATE PVDR_EXPERIMENT_FLOOR=0.001)
    endif()
    add_test(NAME pvdr_${variant}_contracts COMMAND pvdr_${variant} --verify)
endforeach()
