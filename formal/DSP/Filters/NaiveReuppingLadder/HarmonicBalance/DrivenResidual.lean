import DSP.Analysis.FirstOrderTaylor
import DSP.Filters.NaiveReuppingLadder.HarmonicBalance.Residual

/-! Full, unprojected backward-error bounds for the first-order driven HB
ansatz. Frequency pulling must use FirstOrderTaylor.delayed_remainder; it
cannot keep the old delayed waveform fixed. These bounds retain any base and
linear-solve defects and all harmonics generated by the real tanh. -/

noncomputable section
namespace DSP.NaiveReuppingLadder.HarmonicBalance.DrivenApproximation

def saturationQuadraticBound (c : NormalizedTanh.Coefficients ℝ) : ℝ :=
  |c.gain|^2/|c.tanhGain|

theorem curvature_bound (c : NormalizedTanh.Coefficients ℝ) (x : ℝ) :
    |NormalizedTanh.curvature c x| ≤ 2*saturationQuadraticBound c := by
  have ht := Real.abs_tanh_lt_one (x*c.gain)
  have hs := (Real.tanh_sq_lt_one (x*c.gain)).le
  have hz := sq_nonneg (Real.tanh (x*c.gain))
  have hp : |Real.tanh (x*c.gain)*(1-Real.tanh (x*c.gain)^2)| ≤ 1 := by
    rw [abs_mul,abs_of_nonneg (by linarith : 0 ≤ 1-Real.tanh (x*c.gain)^2)]
    nlinarith [abs_nonneg (Real.tanh (x*c.gain))]
  unfold NormalizedTanh.curvature saturationQuadraticBound
  rw [show -2*c.gain^2*Real.tanh (x*c.gain)*(1-Real.tanh (x*c.gain)^2) =
    (-2*c.gain^2)*(Real.tanh (x*c.gain)*(1-Real.tanh (x*c.gain)^2)) by ring]
  simp only [abs_div,abs_mul,abs_pow,abs_neg,abs_of_pos (by norm_num : (0:ℝ) < 2)]
  have h := mul_le_mul_of_nonneg_left hp (by positivity : 0 ≤ 2*|c.gain|^2)
  calc
    _ ≤ (2*|c.gain|^2)/|c.tanhGain| :=
      div_le_div_of_nonneg_right (by simpa only [abs_mul,abs_of_nonneg (by linarith : 0 ≤ 1-Real.tanh (x*c.gain)^2),mul_one] using h)
        (abs_nonneg _)
    _ = _ := by ring

theorem saturation_remainder (c : NormalizedTanh.Coefficients ℝ) (x A direction : ℝ) :
    |NormalizedTanh.apply c (x+A*direction)-NormalizedTanh.apply c x-
      A*NormalizedTanh.slope c x*direction| ≤ saturationQuadraticBound c*A^2*direction^2 := by
  have h := FirstOrderTaylor.remainder (NormalizedTanh.apply c) (NormalizedTanh.slope c)
    (NormalizedTanh.curvature c) (2*saturationQuadraticBound c)
    (NormalizedTanh.hasDerivAt_apply c) (NormalizedTanh.hasDerivAt_slope c)
    (curvature_bound c) x (A*direction)
  convert h using 1
  · congr 1
    ring
  · ring

/-- One nonlinear Euler stage. `pastLinear` includes the frequency-pulling
term -nu*q'. Base and first-order defects may be nonzero. -/
theorem nonlinear_stage_residual (c : NormalizedTanh.Coefficients ℝ)
    (alpha A current currentLinear previous previousLinear past pastBase pastLinear : ℝ)
    (delayError baseError linearError : ℝ)
    (hd : |past-(pastBase+A*pastLinear)| ≤ delayError)
    (hbase : |current-(1-alpha)*pastBase-alpha*NormalizedTanh.apply c previous| ≤ baseError)
    (hlinear : |currentLinear-(1-alpha)*pastLinear-
      alpha*NormalizedTanh.slope c previous*previousLinear| ≤ linearError) :
    |current+A*currentLinear-(1-alpha)*past-alpha*NormalizedTanh.apply c (previous+A*previousLinear)| ≤
      baseError+|A| * linearError+|1-alpha| * delayError+
        |alpha| * saturationQuadraticBound c*A^2*previousLinear^2 := by
  have he : current+A*currentLinear-(1-alpha)*past-alpha*NormalizedTanh.apply c (previous+A*previousLinear) =
      (current-(1-alpha)*pastBase-alpha*NormalizedTanh.apply c previous)+
      A*(currentLinear-(1-alpha)*pastLinear-alpha*NormalizedTanh.slope c previous*previousLinear)-
      (1-alpha)*(past-(pastBase+A*pastLinear))-
      alpha*(NormalizedTanh.apply c (previous+A*previousLinear)-NormalizedTanh.apply c previous-
        A*NormalizedTanh.slope c previous*previousLinear) := by ring
  rw [he]
  have hfour (a b d e : ℝ) : |a+b-d-e| ≤ |a|+|b|+|d|+|e| :=
    (abs_sub (a+b-d) e).trans (add_le_add
      ((abs_sub (a+b) d).trans (add_le_add (abs_add_le a b) le_rfl)) le_rfl)
  apply (hfour _ _ _ _).trans
  apply add_le_add
  · apply add_le_add
    · apply add_le_add hbase
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left hlinear (abs_nonneg A)
    · rw [abs_mul]
      exact mul_le_mul_of_nonneg_left hd (abs_nonneg _)
  · rw [abs_mul]
    exact (mul_le_mul_of_nonneg_left (saturation_remainder c previous A previousLinear)
      (abs_nonneg alpha)).trans_eq (by ring)

/-- The input stage is linear but has TWO shifted histories, including the
original one-sample-delayed fourth-stage feedback. -/
theorem input_stage_residual
    (alpha k A input current currentLinear past pastBase pastLinear feedback feedbackBase feedbackLinear : ℝ)
    (pastError feedbackError baseError linearError : ℝ)
    (hp : |past-(pastBase+A*pastLinear)| ≤ pastError)
    (hf : |feedback-(feedbackBase+A*feedbackLinear)| ≤ feedbackError)
    (hbase : |current-(1-alpha)*pastBase+alpha*k*feedbackBase| ≤ baseError)
    (hlinear : |currentLinear-(1-alpha)*pastLinear+alpha*k*feedbackLinear-alpha*input| ≤ linearError) :
    |current+A*currentLinear-(1-alpha)*past+alpha*k*feedback-alpha*A*input| ≤
      baseError+|A| * linearError+|1-alpha| * pastError+|alpha*k| * feedbackError := by
  have he : current+A*currentLinear-(1-alpha)*past+alpha*k*feedback-alpha*A*input =
      (current-(1-alpha)*pastBase+alpha*k*feedbackBase)+
        A*(currentLinear-(1-alpha)*pastLinear+alpha*k*feedbackLinear-alpha*input)-
        (1-alpha)*(past-(pastBase+A*pastLinear))+alpha*k*(feedback-(feedbackBase+A*feedbackLinear)) := by ring
  rw [he]
  apply (abs_add_le _ _).trans
  apply add_le_add
  · apply (abs_sub _ _).trans
    apply add_le_add
    · apply (abs_add_le _ _).trans
      apply add_le_add hbase
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_left hlinear (abs_nonneg _)
    · rw [abs_mul]
      exact mul_le_mul_of_nonneg_left hp (abs_nonneg _)
  · rw [abs_mul]
    exact mul_le_mul_of_nonneg_left hf (abs_nonneg _)

/-- Explicit waveform error for the proposed first-order output, including
the final saturator and any certified distance to the exact HB fourth stage. -/
theorem output_remainder (c : NormalizedTanh.Coefficients ℝ) (k x base A direction stateError : ℝ)
    (hx : |x-(base+A*direction)| ≤ stateError) :
    |(k+1)*NormalizedTanh.apply c x-
      (k+1)*(NormalizedTanh.apply c base+A*NormalizedTanh.slope c base*direction)| ≤
      |k+1| * ((|c.gain|/|c.tanhGain|)*stateError+saturationQuadraticBound c*A^2*direction^2) := by
  have hs := saturation_difference_bound c x (base+A*direction)
  have ht := saturation_remainder c base A direction
  rw [← mul_sub,abs_mul]
  apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
  have he : NormalizedTanh.apply c x-(NormalizedTanh.apply c base+A*NormalizedTanh.slope c base*direction) =
      (NormalizedTanh.apply c x-NormalizedTanh.apply c (base+A*direction))+
        (NormalizedTanh.apply c (base+A*direction)-NormalizedTanh.apply c base-
          A*NormalizedTanh.slope c base*direction) := by ring
  rw [he]
  apply (abs_add_le _ _).trans
  exact add_le_add (hs.trans (mul_le_mul_of_nonneg_left hx (by positivity))) ht

end DSP.NaiveReuppingLadder.HarmonicBalance.DrivenApproximation
