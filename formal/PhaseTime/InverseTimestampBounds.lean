import PhaseTime.InverseResolution
import PhaseTime.InverseCodegen
import Mathlib.Data.EReal.Basic

namespace PhaseTime.InverseRuntime

open InverseResolution

/-- Model finite-operand roundings as real values with possible overflow to
    infinity. Only monotonicity and exactness on representable values are used. -/
structure TimestampRounding (representable : ℝ → Prop) where
  round : ℝ → EReal
  monotone : Monotone round
  exact : ∀ x, representable x → round x = (x : EReal)

def Binary32 (x : ℝ) : Prop :=
  ∃ m e : ℤ, |m| < 2 ^ 24 ∧ -149 ≤ e ∧ e ≤ 104 ∧ x = (m : ℝ) * 2 ^ e

theorem binary32_widens {x : ℝ} (h : Binary32 x) : Binary64 x := by
  obtain ⟨m, e, hm, hlow, hhigh, value⟩ := h
  exact ⟨m, e, hm.trans_le (by decide), by omega, by omega, value⟩

private def Within (x : EReal) (lo hi : ℝ) : Prop :=
  (lo : EReal) ≤ x ∧ x ≤ (hi : EReal)

private theorem Within.finite {x : EReal} {lo hi : ℝ} (h : Within x lo hi) :
    x = (x.toReal : EReal) ∧ lo ≤ x.toReal ∧ x.toReal ≤ hi := by
  have finite := (EReal.coe_toReal (ne_top_of_le_ne_top (EReal.coe_ne_top hi) h.2)
    (ne_bot_of_le_ne_bot (EReal.coe_ne_bot lo) h.1)).symm
  exact ⟨finite, EReal.coe_le_coe_iff.mp (finite ▸ h.1), EReal.coe_le_coe_iff.mp (finite ▸ h.2)⟩

private theorem TimestampRounding.enclose {format : ℝ → Prop} (r : TimestampRounding format)
    {x lo hi : ℝ} (low : format lo) (high : format hi) (inside : lo ≤ x ∧ x ≤ hi) :
    Within (r.round x) lo hi := by
  exact ⟨r.exact _ low ▸ r.monotone inside.1, r.exact _ high ▸ r.monotone inside.2⟩

private theorem TimestampRounding.encloseAbs {format : ℝ → Prop} (r : TimestampRounding format)
    {x limit : ℝ} (high : format limit) (low : format (-limit)) (bound : |x| ≤ limit) :
    Within (r.round x) (-limit) limit :=
  r.enclose low high (abs_le.mp bound)

private theorem Within.abs {x : EReal} {limit : ℝ} (h : Within x (-limit) limit) :
    |x.toReal| ≤ limit :=
  abs_le.mpr h.finite.2

private theorem binary64_zero : Binary64 0 :=
  ⟨0, 0, by norm_num, by norm_num, by norm_num, by norm_num⟩

private theorem binary32_deltaLimits : Binary32 ((2 : ℝ) ^ 67) ∧ Binary32 (-((2 : ℝ) ^ 67)) := by
  constructor
  · exact ⟨1, 67, by norm_num, by norm_num, by norm_num, by norm_num⟩
  · exact ⟨-1, 67, by norm_num, by norm_num, by norm_num, by norm_num⟩

/-- Every timestamp generated by forward scatter fits the stored absolute
    timestamp range. The grid edge lies between the two scaled observations. -/
theorem roundedInterpolationBound (r : TimestampRounding Binary64)
    (left right : Point ℝ) (q : ℤ)
    (phaseLeft : |left.phase| ≤ (2 : ℝ) ^ 52) (phaseRight : |right.phase| ≤ (2 : ℝ) ^ 52)
    (timeLeft : |left.time| ≤ (2 : ℝ) ^ 64) (timeRight : |right.time| ≤ (2 : ℝ) ^ 64)
    (visited : ⌈left.phase⌉ ≤ q ∧ q ≤ ⌊right.phase⌋)
    (width : 0 < (r.round (right.phase - left.phase)).toReal) :
    ∃ time : ℝ, interpolateUsing (fun x y => (r.round (x - y)).toReal)
      (fun x y => (r.round (x / y)).toReal) (fun x y => (r.round (x * y)).toReal)
      (fun x y => r.round (x + y)) left right q = (time : EReal) ∧ |time| ≤ (2 : ℝ) ^ 66 := by
  have inside : left.phase ≤ (q : ℝ) ∧ (q : ℝ) ≤ right.phase :=
    ⟨Int.ceil_le.mp visited.1, Int.le_floor.mp visited.2⟩
  have phaseSpan : right.phase - left.phase ≤ (2 : ℝ) ^ 53 := by
    linarith [(abs_le.mp phaseLeft).1, (abs_le.mp phaseRight).2]
  have den := r.enclose binary64_zero (binary64_signedPower 53 (by decide) (by decide)).1
    ⟨by linarith [inside.1, inside.2], phaseSpan⟩
  have num := r.enclose binary64_zero (binary64_signedPower 53 (by decide) (by decide)).1
    ⟨sub_nonneg.mpr inside.1, by linarith [inside.2]⟩
  have divided : 0 ≤ (r.round (q - left.phase)).toReal / (r.round (right.phase - left.phase)).toReal ∧
      (r.round (q - left.phase)).toReal / (r.round (right.phase - left.phase)).toReal ≤ 1 := by
    refine ⟨div_nonneg num.finite.2.1 width.le, (div_le_one width).mpr ?_⟩
    have ordered := r.monotone (sub_le_sub_right inside.2 left.phase)
    have finiteNum := num.finite.1
    have finiteDen := den.finite.1
    rwa [finiteNum, finiteDen, EReal.coe_le_coe_iff] at ordered
  let alpha := (r.round ((r.round (q - left.phase)).toReal /
    (r.round (right.phase - left.phase)).toReal)).toReal
  have hAlpha : 0 ≤ alpha ∧ alpha ≤ 1 :=
    (r.enclose binary64_zero (by simpa using (binary64_signedPower 0 (by decide) (by decide)).1)
      divided).finite.2
  have ⟨high, low⟩ := binary64_signedPower 65 (by decide) (by decide)
  have timeSpan : |right.time - left.time| ≤ (2 : ℝ) ^ 65 := by
    have triangle := abs_sub_le right.time 0 left.time
    simp only [sub_zero, zero_sub, abs_neg] at triangle
    linarith
  let diff := (r.round (right.time - left.time)).toReal
  have hDiff : |diff| ≤ (2 : ℝ) ^ 65 := (r.encloseAbs high low timeSpan).abs
  have mulBound : |alpha * diff| ≤ (2 : ℝ) ^ 65 := by
    rw [abs_mul, abs_of_nonneg hAlpha.1]
    exact (mul_le_of_le_one_left (abs_nonneg diff) hAlpha.2).trans hDiff
  have offset := (r.encloseAbs high low mulBound).abs
  have sum : |left.time + (r.round (alpha * diff)).toReal| ≤ (2 : ℝ) ^ 66 := by
    have triangle := abs_add_le left.time (r.round (alpha * diff)).toReal
    linarith
  have ⟨hi, lo⟩ := binary64_signedPower 66 (by decide) (by decide)
  have result := r.encloseAbs hi lo sum
  exact ⟨_, result.finite.1, result.abs⟩

theorem roundedEncodeBound (r64 : TimestampRounding Binary64) (r32 : TimestampRounding Binary32)
    {base time : ℝ} (hb : |base| ≤ (2 : ℝ) ^ 66) (ht : |time| ≤ (2 : ℝ) ^ 66) :
    ∃ delta : ℝ, r32.round (r64.round (time - base)).toReal = (delta : EReal) ∧
      |delta| ≤ (2 : ℝ) ^ 67 := by
  have bound : |time - base| ≤ (2 : ℝ) ^ 67 := by
    have triangle := abs_sub_le time 0 base
    simp only [sub_zero, zero_sub, abs_neg] at triangle
    linarith
  have ⟨hi, lo⟩ := binary64_signedPower 67 (by decide) (by decide)
  have delta := (r64.encloseAbs hi lo bound).abs
  have result := r32.encloseAbs binary32_deltaLimits.1 binary32_deltaLimits.2 delta
  exact ⟨_, result.finite.1, result.abs⟩

theorem roundedDecodeBound (r : TimestampRounding Binary64) {base delta : ℝ}
    (hb : |base| ≤ (2 : ℝ) ^ 66) (hd : |delta| ≤ (2 : ℝ) ^ 67) :
    ∃ time : ℝ, r.round (base + delta) = (time : EReal) ∧ |time| ≤ (2 : ℝ) ^ 68 := by
  have bound : |base + delta| ≤ (2 : ℝ) ^ 68 := by
    have triangle := abs_add_le base delta
    linarith
  have ⟨hi, lo⟩ := binary64_signedPower 68 (by decide) (by decide)
  have result := r.encloseAbs hi lo bound
  exact ⟨_, result.finite.1, result.abs⟩

/-- Connect the stored-value bounds to the Float reader contract through the
    native interpretations of widening, addition, and finiteness. -/
theorem decodablePayload_of_bounded_atoms {n : Nat} (p : Published Float Float32 n)
    (value64 : Float → EReal) (value32 : Float32 → EReal) (r : TimestampRounding Binary64)
    (decode : ∀ base delta (x y : ℝ), value64 base = (x : EReal) → value32 delta = (y : EReal) →
      value64 (decodeTimestamp base delta) = r.round (x + y))
    (finite : ∀ time (x : ℝ), value64 time = (x : EReal) → time.isFinite = true)
    (baseRange : ∀ slot : Fin (n + 1), ∀ base ∈ (p.cells.get slot).base,
      ∃ x : ℝ, value64 base = (x : EReal) ∧ |x| ≤ (2 : ℝ) ^ 66)
    (deltaRange : ∀ slot : Fin (n + 1), ∀ branch ∈ (p.cells.get slot).replacement,
      ∀ delta : Float32, delta = branch.start ∨ delta ∈ branch.stop →
      ∃ y : ℝ, value32 delta = (y : EReal) ∧ |y| ≤ (2 : ℝ) ^ 67) :
    DecodablePayload p := by
  intro slot base hb branch hr
  obtain ⟨x, hx, hbx⟩ := baseRange slot base hb
  have valid (delta : Float32) (written : delta = branch.start ∨ delta ∈ branch.stop) :
      (decodeTimestamp base delta).isFinite = true := by
    obtain ⟨y, hy, hdy⟩ := deltaRange slot branch hr delta written
    obtain ⟨time, htime, _⟩ := roundedDecodeBound r hbx hdy
    exact finite _ time ((decode base delta x y hx hy).trans htime)
  exact ⟨valid branch.start (Or.inl rfl), fun delta h => valid delta (Or.inr h)⟩

end PhaseTime.InverseRuntime
